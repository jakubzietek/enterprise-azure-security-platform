AZKVAuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "SecretSet"
| where HttpStatusCode == 403
| project
    TimeGenerated,
    _ResourceId,
    OperationName,
    HttpStatusCode,
    IsRbacAuthorized,
    Identity,
    CallerIpAddress,
    RequestUri,
    ResultDescription
| order by TimeGenerated desc
